<Window x:Class="IPProcessingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPProcessingTool"
        Title="RBC Capital Markets — IP Processing Tool"
        Height="720" Width="1150"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>

        <!-- ── BUTTON TEMPLATE (shared) ── -->
        <ControlTemplate x:Key="RbcButtonTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.83"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.68"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── BASE TOOLBAR BUTTON ── -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Margin"          Value="3,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"        Value="{StaticResource RbcButtonTemplate}"/>
        </Style>

        <!-- Primary / Scan -->
        <Style x:Key="BtnScan" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#0057B8"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Padding"    Value="22,0"/>
        </Style>

        <!-- Outlined (secondary) -->
        <Style x:Key="BtnOutline" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Success (save) -->
        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

        <!-- Amber (WoL) -->
        <Style x:Key="BtnAmber" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#B45309"/>
        </Style>

        <!-- Danger (stop / clear) -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <!-- Header ghost button (dark bg) -->
        <Style x:Key="BtnHeader" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#4A7CB8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"        Value="{StaticResource RbcButtonTemplate}"/>
        </Style>

        <!-- ── DATAGRID ── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#E2E8F0"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="RowBackground"            Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="RowHeight"                Value="30"/>
            <Setter Property="FontSize"                 Value="12.5"/>
            <Setter Property="Foreground"               Value="#1E293B"/>
            <Setter Property="ColumnHeaderHeight"       Value="34"/>
            <Setter Property="SelectionMode"            Value="Extended"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
            <Setter Property="CanUserResizeColumns"     Value="True"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"       Value="#1E3A5F"/>
            <Setter Property="Foreground"       Value="#E2E8F0"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="BorderBrush"      Value="#2D4F7F"/>
            <Setter Property="BorderThickness"  Value="0,0,1,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── PROGRESS BAR ── -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height"          Value="6"/>
            <Setter Property="Background"      Value="#E2E8F0"/>
            <Setter Property="Foreground"      Value="#0057B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Header -->
            <RowDefinition Height="52"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="28"/>   <!-- Progress -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             HEADER BAR
        ══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#002D62">
            <Grid Margin="16,0">

                <!-- Logo + title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/images/RBC-Logo.png"
                           Height="30" Width="60"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,12,0"/>
                    <Rectangle Width="1" Fill="#3A6EA8" Margin="0,10,12,10"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IP Processing Tool"
                                   FontSize="15" FontWeight="Bold" Foreground="White"
                                   LineHeight="18"/>
                        <TextBlock Text="RBC Capital Markets"
                                   FontSize="11" Foreground="#7AAFD4"
                                   LineHeight="15"/>
                    </StackPanel>
                </StackPanel>

                <!-- Settings -->
                <Button Name="SettingsButton"
                        Content="⚙  Settings"
                        Click="SettingsButton_Click"
                        Style="{StaticResource BtnHeader}"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════
             TOOLBAR
        ══════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">

                <!-- Left group: primary actions -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                    <Button Name="ScanButton"
                            Content="🔍  Start Scan"
                            Click="ScanButton_Click"
                            Style="{StaticResource BtnScan}"/>

                    <!-- Visual divider -->
                    <Rectangle Width="1" Fill="#E2E8F0" Margin="10,6"/>

                    <Button Name="RescanButton"
                            Content="↺  Rescan"
                            Click="RescanButton_Click"
                            Style="{StaticResource BtnOutline}"/>

                    <Button Name="SaveButton"
                            Content="💾  Save"
                            Click="SaveButton_Click"
                            Style="{StaticResource BtnSuccess}"/>

                    <Button Name="WakeOnLANButton"
                            Content="⚡  Wake-on-LAN"
                            Click="WakeOnLANButton_Click"
                            Style="{StaticResource BtnAmber}"/>
                </StackPanel>

                <!-- Right group: destructive actions -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Name="StopButton"
                            Content="■  Stop"
                            Click="StopButton_Click"
                            Style="{StaticResource BtnDanger}"/>

                    <Button Name="ClearButton"
                            Content="🗑  Clear"
                            Click="ClearButton_Click"
                            Style="{StaticResource BtnOutline}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════
             DATAGRID
        ══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="12,10,12,0"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <DataGrid Name="StatusDataGrid"/>
        </Border>

        <!-- ══════════════════════════════════════
             PROGRESS ROW
        ══════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="12,8,12,0">
            <ProgressBar Name="ProgressBar"/>
            <TextBlock Name="ProgressText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#374151"/>
        </Grid>

        <!-- ══════════════════════════════════════
             STATUS BAR
        ══════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <TextBlock Name="StatusBarText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="#64748B"
                       VerticalAlignment="Center"
                       Margin="16,0"/>
        </Border>

    </Grid>
</Window>
