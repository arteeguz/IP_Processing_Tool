<Window x:Class="IPProcessingTool.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — IP Processing Tool"
        Height="800" Width="760"
        MinHeight="600" MinWidth="680"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- ── BUTTON TEMPLATE ── -->
        <ControlTemplate x:Key="BtnTpl" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.83"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.68"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Margin"          Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"        Value="{StaticResource BtnTpl}"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#0057B8"/>
        </Style>
        <Style x:Key="BtnNeutral" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="TxtBox" TargetType="TextBox">
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Height"                   Value="34"/>
            <Setter Property="Foreground"               Value="#1E293B"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#CBD5E1"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox -->
        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Foreground"              Value="#374151"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="Margin"                  Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"                  Value="Hand"/>
        </Style>

        <!-- Section card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Margin"          Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable content -->
            <RowDefinition Height="60"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Border Grid.Row="0" Background="#002D62">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="⚙" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Configure scan behaviour, performance and column visibility"
                               FontSize="11" Foreground="#7AAFD4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── SCROLLABLE CONTENT ── -->
        <ScrollViewer Grid.Row="1"
                      Margin="16,12,16,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ─ Column Visibility ─ -->
                <TextBlock Text="Data Columns"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="4,0,0,6"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Choose which fields are collected and shown in the results grid."
                                   FontSize="12" Foreground="#64748B"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="DataColumnsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected}"
                                              Style="{StaticResource Chk}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ─ Auto-save ─ -->
                <TextBlock Text="Saving"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="4,0,0,6"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AutoSaveCheckBox"
                                  Content="Auto-save results when scan completes"
                                  Style="{StaticResource Chk}"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="Skips the save prompt and writes the CSV automatically."
                                   FontSize="12" Foreground="#64748B"
                                   Margin="20,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ─ Performance ─ -->
                <TextBlock Text="Performance"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="4,0,0,6"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Ping timeout -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Ping Timeout"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PingTimeoutTextBox"
                                         Style="{StaticResource TxtBox}"
                                         Grid.Column="0"/>
                                <TextBlock Text="ms" Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="#64748B"
                                           Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="1000 – 10000 ms"
                                       FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Max concurrent scans -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Max Concurrent Scans"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MaxConcurrentScansTextBox"
                                         Style="{StaticResource TxtBox}"
                                         Grid.Column="0"/>
                                <TextBlock Text="threads" Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="#64748B"
                                           Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="1 – 50"
                                       FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Execution time limit -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Per-IP Execution Time Limit"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,4"/>
                            <Grid HorizontalAlignment="Left" Width="260">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExecutionTimeLimitTextBox"
                                         Style="{StaticResource TxtBox}"
                                         Grid.Column="0"/>
                                <TextBlock Text="seconds" Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="#64748B"
                                           Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="10 – 300 seconds. Per-host cap before marking as Timeout."
                                       FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─ Floor Mappings ─ -->
                <TextBlock Text="Floor Mappings"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="4,0,0,6"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Map IP subnet segments (first 3 octets, e.g. 10.9.115) to office floor names. Double-click a cell to edit."
                                   FontSize="12" Foreground="#64748B"
                                   Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <DataGrid x:Name="FloorMappingsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  BorderBrush="#E2E8F0"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FAFC"
                                  FontSize="13"
                                  MaxHeight="200"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP Segment" Binding="{Binding Segment, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Floor / Location" Binding="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Add Row"
                                    Click="AddMappingRow_Click"
                                    Style="{StaticResource BtnNeutral}"
                                    Height="30" Padding="12,0" Margin="0,0,8,0"/>
                            <Button Content="Remove Selected"
                                    Click="RemoveMappingRow_Click"
                                    Style="{StaticResource BtnNeutral}"
                                    Height="30" Padding="12,0" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ─ Tips ─ -->
                <Border Background="#FEF9C3"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="💡  Tips"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#92400E" Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" Foreground="#92400E" TextWrapping="Wrap" LineHeight="20">
                            <Run Text="•  Lower ping timeout = faster scanning but may miss slow or distant devices."/>
                            <LineBreak/>
                            <Run Text="•  More concurrent scans = faster total time but higher network utilisation."/>
                            <LineBreak/>
                            <Run Text="•  Reduce the execution limit if WMI is consistently timing out."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── FOOTER ── -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Style="{StaticResource BtnNeutral}"/>
                <Button Content="💾  Save Settings"
                        Click="SaveButton_Click"
                        Style="{StaticResource BtnPrimary}"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
