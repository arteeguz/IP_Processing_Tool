<Window x:Class="IPProcessingTool.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RBC IP Processing Tool Settings" Height="700" Width="750" Background="#F8F9FA" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern GroupBox Style -->
        <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>

                            <ContentPresenter Grid.Row="0"
                                              ContentSource="Header"
                                              Margin="15,10,15,5"
                                              TextBlock.FontWeight="Bold"
                                              TextBlock.FontSize="16"
                                              TextBlock.Foreground="#005A9E"/>

                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Image Source="pack://application:,,,/images/RBC-Logo.png" Width="80" Height="40" Margin="0,0,15,0"/>
                <TextBlock Text="⚙️ Settings" FontSize="28" FontWeight="Bold" Foreground="#005A9E" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Configure your IP Processing Tool preferences" 
                       FontSize="14" Foreground="#666" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Data Columns Configuration -->
                <GroupBox Header="🔍 Data Retrieval &amp; Display Settings" Style="{StaticResource ModernGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="Select which information to collect and display during scans:" 
                                   FontSize="13" Foreground="#666" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="6" Padding="15">
                            <ItemsControl x:Name="DataColumnsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" 
                                                  IsChecked="{Binding IsSelected}" 
                                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- General Settings -->
                <GroupBox Header="⚙️ General Settings" Style="{StaticResource ModernGroupBoxStyle}">
                    <StackPanel>
                        <!-- Auto Save Setting -->
                        <Border Background="#E8F4FD" BorderBrush="#B3D9FF" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="AutoSaveCheckBox" 
                                          Content="🔄 Auto-save results after scan completion" 
                                          Style="{StaticResource ModernCheckBoxStyle}"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="Automatically save scan results to a CSV file when scanning is complete" 
                                           FontSize="12" Foreground="#666" Margin="20,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Performance Settings -->
                        <TextBlock Text="🚀 Performance Settings" FontWeight="Bold" FontSize="16" Foreground="#005A9E" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ping Timeout -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="⏱️ Ping Timeout" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <DockPanel>
                                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666"/>
                                    <TextBox x:Name="PingTimeoutTextBox" 
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </DockPanel>
                                <TextBlock Text="How long to wait for ping responses (1000-10000ms)" 
                                           FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Max Concurrent Scans -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                <TextBlock Text="🔄 Max Concurrent Scans" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <DockPanel>
                                    <TextBlock Text="threads" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666"/>
                                    <TextBox x:Name="MaxConcurrentScansTextBox" 
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </DockPanel>
                                <TextBlock Text="Number of simultaneous scan operations (1-50)" 
                                           FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Execution Time Limit -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,15">
                                <TextBlock Text="⏰ Execution Time Limit per IP" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <DockPanel HorizontalAlignment="Left">
                                    <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666"/>
                                    <TextBox x:Name="ExecutionTimeLimitTextBox" 
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Width="200"/>
                                </DockPanel>
                                <TextBlock Text="Maximum time to spend scanning each IP address (10-300 seconds)" 
                                           FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Performance Tips -->
                        <Border Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="💡 Performance Tips" FontWeight="Bold" FontSize="14" Foreground="#856404"/>
                                <TextBlock FontSize="12" Foreground="#856404" TextWrapping="Wrap" Margin="0,5,0,0">
                                    <Run Text="• Lower ping timeout = faster scanning but may miss slow devices"/>
                                    <LineBreak/>
                                    <Run Text="• Higher concurrent scans = faster overall but more network load"/>
                                    <LineBreak/>
                                    <Run Text="• Adjust based on your network performance and requirements"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="-30,20,-30,-30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="💾 Save Settings" 
                        Click="SaveButton_Click" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Width="130" 
                        Margin="0,0,15,0"/>
                <Button Content="❌ Cancel" 
                        Click="CancelButton_Click" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>