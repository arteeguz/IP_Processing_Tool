<Window x:Class="IPProcessingTool.ModernInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Scan — Royal IP Scanner"
        Height="600" Width="860"
        MinHeight="520" MinWidth="700"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- ── BUTTON TEMPLATE ── -->
        <ControlTemplate x:Key="BtnTpl" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.83"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.68"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Base button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"        Value="{StaticResource BtnTpl}"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#0057B8"/>
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Padding"    Value="24,0"/>
            <Setter Property="FontSize"   Value="14"/>
        </Style>
        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>
        <Style x:Key="BtnNeutral" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>
        <Style x:Key="BtnInfo" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#0891B2"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Foreground"       Value="#1E293B"/>
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#CBD5E1"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Header bar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status -->
            <RowDefinition Height="60"/>   <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Border Grid.Row="0" Background="#002D62">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="🔍" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configure Scan Targets"
                               FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Enter IPs, hostnames, ranges, CIDR blocks, or upload a file"
                               FontSize="11" Foreground="#7AAFD4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── CONTENT ── -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Left: text input -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Manual Input"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,6"/>

                <Grid Grid.Row="1">
                    <TextBox Name="InputTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalAlignment="Stretch"
                             Foreground="#1E293B"
                             TextChanged="InputTextBox_TextChanged"/>
                    <TextBlock IsHitTestVisible="False"
                               Foreground="#9CA3AF"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Padding="12,10"
                               VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Enter one or more targets (one per line):"/><LineBreak/>
                        <Run Text="• IP addresses: 192.168.1.1"/><LineBreak/>
                        <Run Text="• Hostnames: server01.company.com"/><LineBreak/>
                        <Run Text="• IP ranges: 192.168.1.1-192.168.1.100"/><LineBreak/>
                        <Run Text="• CIDR notation: 192.168.1.0/24"/><LineBreak/>
                        <Run Text="• Segments: 192.168.1 (expands to .0-.255)"/>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Name="PasteButton"   Content="📋  Paste"          Click="PasteButton_Click"  Style="{StaticResource BtnInfo}"/>
                    <Button Name="ClearInputButton" Content="Clear"           Click="ClearInput_Click"   Style="{StaticResource BtnNeutral}"/>
                </StackPanel>
            </Grid>

            <!-- Right: file upload + estimate -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File card -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="File Upload"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,10"/>
                        <Button Name="SelectFileButton"
                                Content="📁  Select CSV / TXT"
                                Click="SelectFileButton_Click"
                                Style="{StaticResource BtnSuccess}"
                                HorizontalAlignment="Stretch"/>
                        <TextBlock Name="SelectedFileLabel"
                                   Text="No file selected"
                                   FontSize="11.5"
                                   Foreground="#9CA3AF"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Estimate card -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Estimate"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,6"/>
                        <TextBlock Name="EstimateLabel"
                                   Text="—"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Supported formats hint -->
                <Border Grid.Row="2"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Supported formats"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1D4ED8"
                                   Margin="0,0,0,4"/>
                        <TextBlock FontSize="11.5" Foreground="#3B82F6" TextWrapping="Wrap" LineHeight="18">
                            <Run Text="192.168.1.5"/>           <LineBreak/>
                            <Run Text="192.168.1.1-192.168.1.50"/>  <LineBreak/>
                            <Run Text="192.168.1.0/24"/>        <LineBreak/>
                            <Run Text="192.168.1"/>             <LineBreak/>
                            <Run Text="server01.domain.com"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ── STATUS MESSAGE ── -->
        <Border Grid.Row="2"
                Name="StatusBorder"
                Margin="20,10,20,0"
                Padding="12"
                CornerRadius="6"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="StatusTitle" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Name="StatusMessage" FontSize="13" Margin="8,0,0,0"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── FOOTER BUTTONS ── -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Button Name="ClearPreviewButton"
                        Content="🗑  Clear All"
                        Click="ClearPreview_Click"
                        Style="{StaticResource BtnDanger}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Name="CancelButton"
                            Content="Cancel"
                            Click="Cancel_Click"
                            Style="{StaticResource BtnNeutral}"/>
                    <Button Name="StartScanButton"
                            Content="🚀  Start Scan"
                            Click="StartScan_Click"
                            Style="{StaticResource BtnPrimary}"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hidden listbox for compatibility -->
        <ListBox Name="PreviewListBox" Visibility="Collapsed"/>

    </Grid>
</Window>
