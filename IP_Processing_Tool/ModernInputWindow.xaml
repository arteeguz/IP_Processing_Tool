<Window x:Class="IPProcessingTool.ModernInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart IP Scanner Input" Height="500" Width="800" Background="#F8F9FA" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔍 Smart IP Scanner" FontSize="24" FontWeight="Bold" Foreground="#005A9E" HorizontalAlignment="Center"/>
            <TextBlock Text="Enter IPs, hostnames, ranges, segments, or upload files - we'll figure out what you want to scan!" 
                       FontSize="14" Foreground="#666" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Input Section -->
        <GroupBox Grid.Row="1" Header="Input Targets" Margin="0,0,0,20" Padding="15">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="16" Foreground="#005A9E"/>
                        <TextBlock Name="CountLabel" Text="" FontWeight="Bold" FontSize="14" Foreground="#28A745" Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </GroupBox.HeaderTemplate>

            <StackPanel>
                <!-- Text Input Area -->
                <TextBlock Text="Manual Input" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                <TextBox Name="InputTextBox" 
                         Height="120" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto"
                         Text="Enter one or more targets (one per line):&#x0A;• IP addresses: 192.168.1.1&#x0A;• Hostnames: google.com, server01.company.com&#x0A;• IP ranges: 192.168.1.1-192.168.1.100&#x0A;• CIDR notation: 192.168.1.0/24&#x0A;• Segments: 192.168.1 (expands to .0-.255)"
                         Foreground="#999"
                         GotFocus="InputTextBox_GotFocus"
                         LostFocus="InputTextBox_LostFocus"
                         TextChanged="InputTextBox_TextChanged"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Name="PasteButton" Content="📋 Paste from Clipboard" Click="PasteButton_Click" 
                            Background="#17A2B8" Margin="0,0,10,0" Width="160"/>
                    <Button Name="ClearInputButton" Content="🗑️ Clear Input" Click="ClearInput_Click" 
                            Background="#6C757D" Width="120"/>
                </StackPanel>

                <!-- File Upload Section -->
                <Separator Margin="0,20,0,20"/>
                <TextBlock Text="File Upload" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Name="SelectFileButton" Content="📁 Select CSV File" Click="SelectFileButton_Click" 
                            Background="#28A745" Width="140" Margin="0,0,10,0"/>
                    <TextBlock Name="SelectedFileLabel" Text="No file selected" VerticalAlignment="Center" 
                               Foreground="#666" FontStyle="Italic"/>
                </StackPanel>

                <!-- Estimation Display -->
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Center">
                    <TextBlock Name="EstimateLabel" Text="" FontSize="12" Foreground="#666" 
                               TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Status Messages -->
        <Border Grid.Row="2" Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" 
                CornerRadius="6" Padding="10" Margin="0,0,0,20" Name="StatusBorder" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Name="StatusTitle" FontWeight="Bold" FontSize="14"/>
                <TextBlock Name="StatusMessage" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="ProcessInputButton" Content="➕ Process Input" Click="ProcessInput_Click" 
                    Background="#007BFF" Width="130" Margin="0,0,10,0"/>
            <Button Name="ClearPreviewButton" Content="🗑️ Clear All" Click="ClearPreview_Click" 
                    Background="#DC3545" Width="100" Margin="0,0,15,0"/>
            <Button Name="StartScanButton" Content="🚀 Start Scan" Click="StartScan_Click" 
                    Background="#007BFF" Width="120" Margin="0,0,15,0" IsEnabled="False"/>
            <Button Name="CancelButton" Content="❌ Cancel" Click="Cancel_Click" 
                    Background="#6C757D" Width="100"/>
        </StackPanel>

        <!-- Hidden elements for compatibility -->
        <ListBox Name="PreviewListBox" Visibility="Collapsed"/>
    </Grid>
</Window>